# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Claude Code project-scope MCP config (contains FIGMA_API_KEY)
.mcp.json

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Build directories
build/
build-native/
build-docker/
build-x86/
build-arm/
build-cross-deploy/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Development screenshots (iterating on UI)
screenshots/
screenshot_egt.png
*.png

# But: Figma-exported icons under assets/figma/images/ ARE tracked.
!assets/figma/images/*.png

# And: the report images shown in docs/10-reports/ui-improvement-report.md ARE
# tracked (the composed per-screen comparison.png and the demo-vs-real side-by-sides).
# The before/target/after working captures stay ignored.
!docs/10-reports/**/comparison.png
!docs/10-reports/demo-vs-real-mode/*.png

# The wireframe report's screenshots ARE tracked (the README embeds them).
!docs/10-reports/wireframe/**/*.png

# Figma parsing scripts (local dev tools, reference local paths)
dump_demo.py
dump_flow.py
parse_figma.py
parse_figma2.py

# Legacy screens (replaced)
src/screens/_legacy/

# VSCode MCP config (contains API tokens)
.vscode/mcp.json

# Local API tokens (Jira, Figma, etc.)
api_key.json
*.api_key.json
figma_token.json
*_token.json

# Claude Code local state and personal notes (ignore contents, not the dir,
# so the team-skills exception below can take effect).
.claude/*
# ...but DO share team skills (reusable generators + their docs).
!.claude/skills/
!.claude/skills/**
CLAUDE.md
.playwright-mcp/

# PDF generator (local dev tool, vendored from sibling projects) + generated PDFs
scripts/generate_pdf/
*.pdf
scripts/generate_ppt/
docs/08-references/sop