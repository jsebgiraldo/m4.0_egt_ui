{
    "name": "EGT App Dev Container",
    "build": {
        "context": "..",
        "dockerfile": "../Dockerfile"
    },
    "runArgs": [
        "--network", "host"
    ],
    "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "settings": {
                "cmake.configureOnOpen": true,
                "cmake.sourceDirectory": "/app",
                "cmake.buildDirectory": "/app/build-native",
                "cmake.configureArgs": ["-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],
                "C_Cpp.default.compileCommands": "/app/build-native/compile_commands.json"
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "twxs.cmake",
                "pkief.vscode-material-icon-theme",
                "mhutchie.git-graph",
                "eamodio.gitlens"
            ]
        }
    }
}
