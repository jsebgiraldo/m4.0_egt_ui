{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug egt-app (simulator)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-x86/egt-app",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "EGT_BACKEND",     "value": "x11" },
                { "name": "EGT_SCREEN_SIZE", "value": "800x480" },
                { "name": "EGT_MOCK_WIFI",   "value": "1" },
                { "name": "DISPLAY",         "value": ":0" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build",
            "setupCommands": [
                {
                    "description": "Pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug egt-app (WiFi Connected)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-x86/egt-app",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "EGT_BACKEND",     "value": "x11" },
                { "name": "EGT_SCREEN_SIZE", "value": "800x480" },
                { "name": "EGT_MOCK_WIFI",   "value": "connected" },
                { "name": "DISPLAY",         "value": ":0" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build",
            "setupCommands": [
                {
                    "description": "Pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
